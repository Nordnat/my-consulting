# ==============================================================================
# Konfiguracja środowiskowa — rafalkamieniarz.com
# Skopiuj ten plik do .env.local i uzupełnij wybraną metodę wysyłki e-mail.
# Jeśli żaden klucz nie jest ustawiony, formularz działa w trybie symulacji (dev),
# logując pełną treść wiadomości do konsoli serwera.
# ==============================================================================

# Docelowy adres odbiorcy wiadomości z formularza kontaktowego (domyślnie: rafal@rafalkamieniarz.com)
CONTACT_EMAIL_TO="rafal@rafalkamieniarz.com"

# ------------------------------------------------------------------------------
# OPCJA 1 (Zalecana dla Vercel / Next.js): Resend (https://resend.com)
# Wystarczy darmowe konto na Resend (3 000 maili / miesięcznie za darmo)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
#EMAIL_FROM="Formularz kontaktowy <kontakt@rafalkamieniarz.com>"
# W trybie testowym Resend przed weryfikacją własnej domeny można użyć:
#EMAIL_FROM="Formularz kontaktowy <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# OPCJA 2: Własny serwer pocztowy SMTP / Gmail / OVH / Cyberfolks / dhosting
# ------------------------------------------------------------------------------
#SMTP_HOST="smtp.twojadomena.pl"
#SMTP_PORT=587
#SMTP_SECURE="false" # ustaw "true" dla portu 465 (SSL)
#SMTP_USER="rafal@rafalkamieniarz.com"
#SMTP_PASS="twoje_haslo_lub_haslo_aplikacji"
#EMAIL_FROM="Rafał Kamieniarz — Kontakt <rafal@rafalkamieniarz.com>"

# ------------------------------------------------------------------------------
# OPCJA 3: Web3Forms (https://web3forms.com) — darmowy klucz bez serwera SMTP
# ------------------------------------------------------------------------------
#WEB3FORMS_ACCESS_KEY=""
